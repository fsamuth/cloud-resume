variable "aws_region" {
  description = "AWS region"
  type        = string
  default     = "eu-west-3"
}

variable "project_name" {
  description = "Project name"
  type        = string
  default     = "fsamuth-resume"
}

variable "domain_name" {
  description = "Domain name"
  type        = string
  default     = "fidele.samuth.com"
}